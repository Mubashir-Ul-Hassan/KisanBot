# KisanBot — environment configuration. Copy to `.env` and fill in.
# NEVER commit real keys. All keys are read from the environment only.

# --- LLM (agent intelligence) ------------------------------------------------
# Provider behind the thin LLM interface (services/llm_client.py). Only "gemini"
# is implemented today; the interface is ready for a Claude implementation later.
LLM_PROVIDER=gemini
# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides. Default gemini-2.5-flash (free-tier friendly + multimodal).
# Note: gemini-2.0-flash may have a free-tier quota of 0 on some accounts.
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Google Maps Platform (Weather + Geocoding) ------------------------------
# One key with the Weather API and Geocoding API enabled.
# https://developers.google.com/maps/documentation/weather/overview
GOOGLE_MAPS_API_KEY=

# --- ISRIC SoilGrids ---------------------------------------------------------
# No key needed. Soil is served from data/soil_cache.json (build it with
# scripts/prefetch_soil.py). Set to 1 ONLY when running that prefetch script,
# never for serving farmers (SoilGrids is beta + rate-limited).
SOIL_ALLOW_LIVE=0
